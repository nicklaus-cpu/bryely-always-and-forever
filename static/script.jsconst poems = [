function enterApp() {
    showDashboard();
}


function showDashboard() {

    document.body.innerHTML = `
        <div class="dashboard">

            <div class="dashboard-content">

                <p class="small">WELCOME TO</p>

                <h1>Bryley</h1>

                <p class="welcome">
                    A little world made just for you ❤️
                </p>

                <div class="menu">

                    <button onclick="showPoems()">
                        📖 Poems
                    </button>

                    <button onclick="openSection('music')">
                        🎵 Music
                    </button>

                    <button onclick="openSection('private')">
                        🔐 Private
                    </button>

                </div>

            </div>

        </div>
    `;
}


// ===============================
// NAVIGATION BUTTONS
// ===============================

function homeButton() {

    return `
        <div class="navigation">

            <button onclick="showDashboard()">
                🏠 Home
            </button>

        </div>
    `;
}


function backButton() {

    return `
        <div class="navigation">

            <button onclick="showPoems()">
                ← Back to Poems
            </button>

            <button onclick="showDashboard()">
                🏠 Home
            </button>

        </div>
    `;
}


// ===============================
// POEMS LIST
// ===============================

function showPoems() {

    let poemCards = "";

    poems.forEach((poem, index) => {

        poemCards += `
            <button
                class="poem-button"
                onclick="openPoem(${index})"
            >
                ${index + 1}. ${poem.title}
            </button>
        `;

    });


    document.body.innerHTML = `

        <div class="page">

            <div class="page-content">

                <p class="small">
                    WORDS FROM MY HEART
                </p>

                <h1>Poems</h1>

                <div class="poem-list">

                    ${poemCards}

                </div>

                ${homeButton()}

            </div>

        </div>
    `;
}


// ===============================
// INDIVIDUAL POEM
// ===============================

function openPoem(index) {

    const poem = poems[index];


    let navigationButtons = "";


    // PREVIOUS BUTTON

    if (index > 0) {

        navigationButtons += `
            <button
                onclick="openPoem(${index - 1})"
            >
                ← Previous
            </button>
        `;

    }


    // NEXT BUTTON

    if (index < poems.length - 1) {

        navigationButtons += `
            <button
                onclick="openPoem(${index + 1})"
            >
                Next →
            </button>
        `;

    }


    document.body.innerHTML = `

        <div class="page">

            <div class="poem-content">

                <p class="small">
                    POEM ${index + 1} OF ${poems.length}
                </p>

                <h1>
                    ${poem.title}
                </h1>

                <div class="poem-text">

                    ${poem.text.replace(/\n/g, "<br><br>")}

                </div>


                <div class="poem-navigation">

                    ${navigationButtons}

                </div>


                ${backButton()}

            </div>

        </div>
    `;
}


